---
import Layout from "../layouts/Layout.astro";

const templateSlots = Array.from({ length: 20 });
---

<Layout
    title="MemeMaker — Make a meme in seconds"
    description="Choose a meme template or upload your own image and start creating."
>
    <main
        class="relative mx-auto min-h-[calc(100dvh-6.5rem)] max-w-350 overflow-hidden px-4 pb-12 pt-8 sm:px-6 lg:pb-8 lg:pt-6"
    >
        <section
            class="relative isolate mx-auto flex min-h-[calc(100dvh-9rem)] max-w-7xl flex-col items-center lg:justify-center"
            aria-labelledby="hero-title"
        >
            <div
                id="templates"
                class="order-2 mt-12 columns-2 gap-4 sm:columns-3 lg:absolute lg:inset-0 lg:order-0 lg:mt-0 lg:block"
                aria-label="Random meme templates"
            >
                {
                    templateSlots.map((_, index) => (
                        <button
                            type="button"
                            class="template-card group relative z-10 mb-4 block w-full aspect-4/3 min-h-36 break-inside-avoid overflow-hidden rounded-2xl border border-white/15 bg-[#202020] text-left shadow-2xl outline-none transition-[transform,box-shadow,border-color] duration-200 hover:z-40 focus-visible:z-40 focus-visible:border-white focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-4 focus-visible:ring-offset-black lg:mb-0 lg:absolute"
                            data-template-card
                            data-slot={index + 1}
                            aria-pressed="false"
                            aria-label={`Preview meme template ${index + 1}`}
                        >
                            <img
                                data-template-image
                                class="block h-full w-full aspect-4/3 object-cover"
                                alt=""
                                loading={index < 4 ? "eager" : "lazy"}
                                decoding="async"
                            />
                            <span
                                class="template-action absolute inset-0 flex items-end bg-linear-to-t from-black via-black/25 to-transparent p-3 opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100"
                                aria-hidden="true"
                            >
                                <span class="flex w-full items-center justify-between gap-2 rounded-full bg-white px-3 py-2 text-xs font-semibold text-black shadow-lg">
                                    Use template
                                    <span class="rounded-full bg-[#dedede] px-2 py-0.5 text-[9px] font-medium uppercase tracking-wide text-[#444]">
                                        Open in Editor
                                    </span>
                                </span>
                            </span>
                        </button>
                    ))
                }
            </div>

            <div
                class="relative z-20 order-1 w-full max-w-md text-center lg:order-0"
            >
                <div
                    class="upload-panel rounded-3xl border border-white/10 bg-black/80 px-4 py-6 shadow-[0_24px_80px_rgba(0,0,0,0.7)] backdrop-blur-xl transition-[border-color,background-color,transform] sm:px-7 sm:py-7"
                    data-upload-drop-zone
                >
                    <p
                        class="mb-2 font-mono text-[9px] uppercase tracking-[0.18em] text-[#929292]"
                    >
                        No watermark · No sign-up needed
                    </p>
                    <h1
                        id="hero-title"
                        class="text-balance text-3xl font-semibold tracking-[-0.055em] text-[#f1f1f1] sm:text-4xl sm:leading-[1.02]"
                    >
                        Make the meme<br />before it gets old.
                    </h1>
                    <p
                        class="mx-auto mt-3 max-w-sm text-pretty text-xs leading-5 text-[#a8a8a8] sm:text-sm"
                    >
                        Pick a template around you or upload your own image.
                        Your next group-chat masterpiece starts here.
                    </p>

                    <div class="mt-4 flex flex-col items-center gap-2">
                        <label
                            for="meme-upload"
                            class="inline-flex min-h-10 cursor-pointer items-center justify-center gap-2 rounded-full bg-[#ededed] px-5 text-xs font-semibold text-black outline-none transition-colors hover:bg-white focus-within:ring-2 focus-within:ring-white focus-within:ring-offset-4 focus-within:ring-offset-black"
                        >
                            <svg
                                class="h-4 w-4"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                aria-hidden="true"
                            >
                                <path d="M12 16V4m0 0L7 9m5-5 5 5"></path>
                                <path d="M5 14v5h14v-5"></path>
                            </svg>
                            Upload your image
                            <input
                                id="meme-upload"
                                class="sr-only"
                                type="file"
                                accept="image/png,image/jpeg,image/jpg,image/webp,image/gif,.png,.jpg,.jpeg,.webp,.gif"
                            />
                        </label>
                        <p
                            id="upload-status"
                            class="min-h-4 max-w-full truncate px-3 text-[10px] text-[#858585]"
                            aria-live="polite"
                        >
                            PNG, JPG, WEBP or GIF · drop anywhere
                        </p>
                    </div>
                </div>
            </div>
            <!-- Scroll hint arrow -->
            <div class="scroll-hint pointer-events-none absolute bottom-6 left-1/2 z-30 -translate-x-1/2" aria-hidden="true">
                <svg class="h-6 w-6 animate-bounce text-[#555]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 5v14M5 12l7 7 7-7"/>
                </svg>
            </div>
        </section>
    </main>

    <!-- ─── Trending Section ─────────────────────────────────── -->
    <section class="mx-auto max-w-350 px-4 pb-20 pt-4 sm:px-6" aria-labelledby="trending-title">
        <div class="mb-8 flex items-center justify-between">
            <div>
                <p class="mb-1 font-mono text-[9px] uppercase tracking-[0.18em] text-[#929292]">Scroll to explore</p>
                <h2 id="trending-title" class="text-xl font-semibold tracking-tight text-ink sm:text-2xl">
                    🔥 Trending Memes
                </h2>
            </div>
            <a href="/templates" class="inline-flex h-8 items-center rounded-full border border-white/10 px-4 text-xs font-medium text-[#9b9b9b] transition-colors hover:border-white/25 hover:text-white">
                Browse all →
            </a>
        </div>

        <div class="columns-2 gap-3 sm:columns-3 lg:columns-4 xl:columns-5">
            {Array.from({ length: 20 }).map((_, i) => (
                <a
                    href={`/edit?template=${i + 1}`}
                    class="trending-card group relative mb-3 block break-inside-avoid overflow-hidden rounded-xl border border-white/10 bg-[#202020] outline-none focus-visible:ring-2 focus-visible:ring-white"
                    data-trending-id={i + 1}
                    aria-label={`Use meme template ${i + 1}`}
                >
                    <img
                        data-trending-img
                        class="block h-auto w-full transition-[filter] duration-300 group-hover:blur-[3px]"
                        alt=""
                        loading="lazy"
                        decoding="async"
                    />
                    <!-- hover overlay -->
                    <span class="absolute inset-0 flex flex-col items-center justify-center gap-2 bg-black/60 opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100" aria-hidden="true">
                        <span class="inline-flex items-center gap-1 rounded-full bg-white px-3 py-1.5 text-[11px] font-semibold text-black shadow">
                            <svg class="h-3 w-3" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M2 14l1.5-4.5L11 2l3 3-7.5 7.5L2 14z"/></svg>
                            Edit template
                        </span>
                    </span>
                </a>
            ))}
        </div>
    </section>

    <!-- ─── Features / Why MemeMaker Section ────────────────── -->
    <section id="features" class="mx-auto max-w-350 border-t border-hairline px-4 py-16 sm:px-6 sm:py-20" aria-labelledby="features-title">
        <div class="mb-12 text-center">
            <p class="mb-1 font-mono text-[9px] uppercase tracking-[0.18em] text-[#929292]">Simple · Fast · Free</p>
            <h2 id="features-title" class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
                Why MemeMaker?
            </h2>
            <p class="mx-auto mt-2 max-w-lg text-xs text-[#a8a8a8] sm:text-sm">
                Everything you need to craft high-impact memes in seconds without friction.
            </p>
        </div>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
            <div id="why-free" class="rounded-2xl border border-white/10 bg-[#17171b] p-6 transition-all duration-200 hover:border-white/20">
                <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-primary/15 text-primary">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                        <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                    </svg>
                </div>
                <h3 class="mb-2 text-base font-semibold text-ink">100% Free Forever</h3>
                <p class="text-xs leading-relaxed text-[#8f8f97] sm:text-sm">
                    No subscriptions, paywalls, or credit card required. Generate and export unlimited memes with high-speed rendering.
                </p>
            </div>

            <div id="no-signup" class="rounded-2xl border border-white/10 bg-[#17171b] p-6 transition-all duration-200 hover:border-white/20">
                <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-cyan-400/15 text-cyan-400">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="17" y1="8" x2="23" y2="14"/><line x1="23" y1="8" x2="17" y2="14"/>
                    </svg>
                </div>
                <h3 class="mb-2 text-base font-semibold text-ink">No Sign-up Required</h3>
                <p class="text-xs leading-relaxed text-[#8f8f97] sm:text-sm">
                    Jump straight into creating without creating an account. Sign-up is totally optional and only used for saving custom templates.
                </p>
            </div>

            <div id="no-watermark" class="rounded-2xl border border-white/10 bg-[#17171b] p-6 transition-all duration-200 hover:border-white/20">
                <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-violet-400/15 text-violet-400">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                        <rect x="3" y="3" width="18" height="18" rx="2"/><path d="m9 9 6 6m0-6-6 6"/>
                    </svg>
                </div>
                <h3 class="mb-2 text-base font-semibold text-ink">Zero Watermarks</h3>
                <p class="text-xs leading-relaxed text-[#8f8f97] sm:text-sm">
                    No forced branding stamped onto your creations. Your downloaded memes are clean, crisp, and ready to share anywhere.
                </p>
            </div>
        </div>
    </section>

    <!-- ─── FAQ Section ───────────────────────────────────────── -->
    <section id="faq" class="mx-auto max-w-350 border-t border-hairline px-4 py-16 sm:px-6 sm:py-20" aria-labelledby="faq-title">
        <div class="mb-12 text-center">
            <p class="mb-1 font-mono text-[9px] uppercase tracking-[0.18em] text-primary">Got Questions?</p>
            <h2 id="faq-title" class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
                Frequently Asked Questions
            </h2>
            <p class="mx-auto mt-2 max-w-lg text-xs text-[#a8a8a8] sm:text-sm">
                Everything you need to know about creating memes on MemeMaker.
            </p>
        </div>

        <div class="mx-auto max-w-3xl space-y-4">
            <details class="group rounded-2xl border border-white/10 bg-[#16161a] p-5 transition-colors open:border-primary/40 open:bg-[#18181e]">
                <summary class="flex cursor-pointer items-center justify-between text-sm font-semibold text-ink outline-none select-none">
                    <span>Is MemeMaker completely free to use?</span>
                    <span class="ml-4 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-white/10 text-xs transition-transform duration-200 group-open:rotate-180 group-open:bg-primary group-open:text-on-primary">
                        ↓
                    </span>
                </summary>
                <div class="mt-3 text-xs leading-relaxed text-[#a8a8b2] sm:text-sm">
                    Yes, MemeMaker is 100% free forever. There are no paywalls, premium tiers, trial expirations, or hidden fees. You can design, customize, and export as many high-resolution memes as you want without paying a single cent.
                </div>
            </details>

            <details class="group rounded-2xl border border-white/10 bg-[#16161a] p-5 transition-colors open:border-primary/40 open:bg-[#18181e]">
                <summary class="flex cursor-pointer items-center justify-between text-sm font-semibold text-ink outline-none select-none">
                    <span>Do I need to sign up or create an account?</span>
                    <span class="ml-4 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-white/10 text-xs transition-transform duration-200 group-open:rotate-180 group-open:bg-primary group-open:text-on-primary">
                        ↓
                    </span>
                </summary>
                <div class="mt-3 text-xs leading-relaxed text-[#a8a8b2] sm:text-sm">
                    No sign-up is required to make and download memes. You can open any template, upload any image, edit captions, and download immediately. An account is purely optional if you wish to sync your own uploaded templates across multiple devices.
                </div>
            </details>

            <details class="group rounded-2xl border border-white/10 bg-[#16161a] p-5 transition-colors open:border-primary/40 open:bg-[#18181e]">
                <summary class="flex cursor-pointer items-center justify-between text-sm font-semibold text-ink outline-none select-none">
                    <span>Will my downloaded memes have watermarks?</span>
                    <span class="ml-4 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-white/10 text-xs transition-transform duration-200 group-open:rotate-180 group-open:bg-primary group-open:text-on-primary">
                        ↓
                    </span>
                </summary>
                <div class="mt-3 text-xs leading-relaxed text-[#a8a8b2] sm:text-sm">
                    Never. We despise obtrusive branding stamps as much as you do. Every meme generated and exported from MemeMaker is completely watermark-free, clean, and ready for Reddit, Discord, Twitter, Slack, or wherever you share.
                </div>
            </details>

            <details class="group rounded-2xl border border-white/10 bg-[#16161a] p-5 transition-colors open:border-primary/40 open:bg-[#18181e]">
                <summary class="flex cursor-pointer items-center justify-between text-sm font-semibold text-ink outline-none select-none">
                    <span>Can I upload my own pictures and photos?</span>
                    <span class="ml-4 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-white/10 text-xs transition-transform duration-200 group-open:rotate-180 group-open:bg-primary group-open:text-on-primary">
                        ↓
                    </span>
                </summary>
                <div class="mt-3 text-xs leading-relaxed text-[#a8a8b2] sm:text-sm">
                    Yes! You can drag and drop your own photo directly onto the homepage or click "Upload your image". You can also upload custom templates directly in our Templates directory to reuse them whenever you want.
                </div>
            </details>

            <details class="group rounded-2xl border border-white/10 bg-[#16161a] p-5 transition-colors open:border-primary/40 open:bg-[#18181e]">
                <summary class="flex cursor-pointer items-center justify-between text-sm font-semibold text-ink outline-none select-none">
                    <span>What image file formats and dimensions are supported?</span>
                    <span class="ml-4 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-white/10 text-xs transition-transform duration-200 group-open:rotate-180 group-open:bg-primary group-open:text-on-primary">
                        ↓
                    </span>
                </summary>
                <div class="mt-3 text-xs leading-relaxed text-[#a8a8b2] sm:text-sm">
                    MemeMaker supports PNG, JPG, JPEG, WEBP, and GIF images. The editor automatically preserves the high aspect ratio and resolution of your source image so your exported graphics stay ultra-sharp.
                </div>
            </details>

            <details class="group rounded-2xl border border-white/10 bg-[#16161a] p-5 transition-colors open:border-primary/40 open:bg-[#18181e]">
                <summary class="flex cursor-pointer items-center justify-between text-sm font-semibold text-ink outline-none select-none">
                    <span>Are my uploaded images kept private and secure?</span>
                    <span class="ml-4 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-white/10 text-xs transition-transform duration-200 group-open:rotate-180 group-open:bg-primary group-open:text-on-primary">
                        ↓
                    </span>
                </summary>
                <div class="mt-3 text-xs leading-relaxed text-[#a8a8b2] sm:text-sm">
                    Yes, 100%. MemeMaker processes your images client-side using your browser's native HTML5 Canvas engine. Your private personal photos are not transmitted to or stored on our servers unless you explicitly sign in and save them to your personal cloud account.
                </div>
            </details>

            <details class="group rounded-2xl border border-white/10 bg-[#16161a] p-5 transition-colors open:border-primary/40 open:bg-[#18181e]">
                <summary class="flex cursor-pointer items-center justify-between text-sm font-semibold text-ink outline-none select-none">
                    <span>What customization controls are available in the editor?</span>
                    <span class="ml-4 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-white/10 text-xs transition-transform duration-200 group-open:rotate-180 group-open:bg-primary group-open:text-on-primary">
                        ↓
                    </span>
                </summary>
                <div class="mt-3 text-xs leading-relaxed text-[#a8a8b2] sm:text-sm">
                    You can add top, bottom, and free-floating text boxes, drag and rotate elements, toggle classic Impact bold font or modern sans-serif typography, customize text fills, black or white strokes/outlines, adjust font sizes, text alignments, and even add stickers.
                </div>
            </details>

            <details class="group rounded-2xl border border-white/10 bg-[#16161a] p-5 transition-colors open:border-primary/40 open:bg-[#18181e]">
                <summary class="flex cursor-pointer items-center justify-between text-sm font-semibold text-ink outline-none select-none">
                    <span>Can I use the memes commercially for marketing or social media?</span>
                    <span class="ml-4 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-white/10 text-xs transition-transform duration-200 group-open:rotate-180 group-open:bg-primary group-open:text-on-primary">
                        ↓
                    </span>
                </summary>
                <div class="mt-3 text-xs leading-relaxed text-[#a8a8b2] sm:text-sm">
                    MemeMaker does not charge any royalties or impose restrictions on exported images. You are free to post your memes across corporate social channels, Discord servers, email newsletters, presentations, and digital marketing campaigns subject to standard fair use.
                </div>
            </details>
        </div>

        <!-- FAQ Schema JSON-LD -->
        <script type="application/ld+json" is:inline>
            {
                "@context": "https://schema.org",
                "@type": "FAQPage",
                "mainEntity": [
                    {
                        "@type": "Question",
                        "name": "Is MemeMaker completely free to use?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Yes, MemeMaker is 100% free forever. There are no paywalls, premium tiers, trial expirations, or hidden fees. You can design, customize, and export unlimited high-resolution memes without paying anything."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "Do I need to sign up or create an account?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "No sign-up is required to make and download memes. You can open any template, upload any image, edit captions, and download immediately."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "Will my downloaded memes have watermarks?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Never. Every meme generated and exported from MemeMaker is completely watermark-free, clean, and ready for social sharing."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "Can I upload my own pictures and photos?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Yes! You can drag and drop your own photo directly onto the homepage or click 'Upload your image' to create memes from your personal images."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "Are my uploaded images kept private and secure?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Yes. MemeMaker processes images client-side directly in your browser using HTML5 Canvas. Your private photos are not uploaded to our servers unless you save them to a personal account."
                        }
                    }
                ]
            }
        </script>
    </section>

    <!-- ─── Comprehensive 600+ Word SEO Guide Section ───────────── -->
    <section id="guide" class="mx-auto max-w-350 border-t border-hairline px-4 py-16 sm:px-6 sm:py-24" aria-labelledby="guide-title">
        <div class="mx-auto max-w-4xl">
            <div class="mb-10 text-center">
                <p class="mb-1 font-mono text-[9px] uppercase tracking-[0.18em] text-primary">Creator Resource &amp; Guide</p>
                <h2 id="guide-title" class="text-2xl font-bold tracking-tight text-ink sm:text-4xl">
                    The Ultimate Free Online Meme Maker: Create, Customize &amp; Share
                </h2>
                <p class="mx-auto mt-3 max-w-2xl text-xs text-[#a8a8a8] sm:text-sm">
                    Discover why millions of creators, developers, and humor enthusiasts choose MemeMaker as their go-to meme generator.
                </p>
            </div>

            <article class="prose prose-invert max-w-none space-y-10 text-sm leading-relaxed text-[#c4c4cc]">
                <div class="rounded-3xl border border-white/10 bg-[#141418] p-6 sm:p-10">
                    <h3 class="text-xl font-bold text-ink">Fast, Frictionless &amp; Modern: The Meme Generator You Deserve</h3>
                    <p class="mt-3">
                        In the fast-moving landscape of internet culture, timing is everything. When a breaking viral news event, hilarious tech fail, or cultural milestone occurs, the window to post the definitive reaction meme is measured in minutes, not hours. Yet traditional online meme generators have become clogged with bloated user interfaces, mandatory account creation walls, slow server-side render queues, and invasive branding stamps.
                    </p>
                    <p class="mt-3">
                        <strong>MemeMaker</strong> was engineered from the ground up to eliminate every single point of friction. By leveraging client-side WebAssembly, modern CSS, and hardware-accelerated HTML5 Canvas rendering, MemeMaker delivers instantaneous interactive editing right in your web browser. You can select an iconic template, type your punchline, customize formatting, and save a crystal-clear PNG image in under ten seconds flat. No credit card, no registration captcha, and zero watermarks stamped onto your joke.
                    </p>
                </div>

                <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
                    <div class="rounded-2xl border border-white/10 bg-[#16161a] p-6">
                        <div class="text-2xl font-bold text-primary">01</div>
                        <h4 class="mt-2 text-base font-semibold text-ink">Select or Upload</h4>
                        <p class="mt-2 text-xs leading-relaxed text-[#8f8f97] sm:text-sm">
                            Browse through hundreds of curated meme templates spanning timeless reaction classics to current trending formats. Have your own funny photo, screenshot, or graphic? Simply drag and drop it into the browser window to instantly launch the editor.
                        </p>
                    </div>

                    <div class="rounded-2xl border border-white/10 bg-[#16161a] p-6">
                        <div class="text-2xl font-bold text-cyan-400">02</div>
                        <h4 class="mt-2 text-base font-semibold text-ink">Customize Captions</h4>
                        <p class="mt-2 text-xs leading-relaxed text-[#8f8f97] sm:text-sm">
                            Craft your punchline with total typographic flexibility. Position top and bottom captions, add free-floating text labels, switch between classic bold all-caps Impact font and modern sleek typefaces, and tweak outline stroke thickness and shadow depth.
                        </p>
                    </div>

                    <div class="rounded-2xl border border-white/10 bg-[#16161a] p-6">
                        <div class="text-2xl font-bold text-violet-400">03</div>
                        <h4 class="mt-2 text-base font-semibold text-ink">Download &amp; Share</h4>
                        <p class="mt-2 text-xs leading-relaxed text-[#8f8f97] sm:text-sm">
                            Export your completed masterpiece with a single click. Download full-resolution, high-definition PNG or WebP images ready to share instantly on Twitter, Reddit, Instagram, TikTok, LinkedIn, Discord communities, or Slack channels.
                        </p>
                    </div>
                </div>

                <div class="rounded-3xl border border-white/10 bg-[#141418] p-6 sm:p-10">
                    <h3 class="text-xl font-bold text-ink">Pro Tips for Crafting High-Impact, Viral Memes</h3>
                    <p class="mt-3">
                        Great memes strike a delicate balance between relatable humor, visual clarity, and typographic punch. To ensure your creations resonate and earn maximum engagement, keep these core principles in mind:
                    </p>
                    <ul class="mt-4 list-disc pl-6 space-y-2 text-[#a8a8b2]">
                        <li>
                            <strong class="text-ink">High-Contrast Readability:</strong> White text with a thick black stroke is the golden standard for classic internet memes because it remains readable over any light or dark background photo. MemeMaker applies this stroke by default so your text never disappears into the graphic.
                        </li>
                        <li>
                            <strong class="text-ink">Brevity Is the Soul of Wit:</strong> Keep setup captions punchy. The best memes deliver their comedic reversal in just a handful of words. If a caption feels crowded, trim adjectives or split the thought across top and bottom placements.
                        </li>
                        <li>
                            <strong class="text-ink">Pick the Right Emotional Template:</strong> Match the nuance of your joke with the template's underlying emotion. Use <em>Two Buttons</em> for difficult dilemmas, <em>Disaster Girl</em> for chaotic schadenfreude, <em>Distracted Boyfriend</em> for fleeting desires over sensible choices, and <em>This Is Fine</em> for stubborn optimism amidst unfolding disaster.
                        </li>
                        <li>
                            <strong class="text-ink">Context Matters:</strong> Tailor your humor to your audience. A meme destined for a tech Discord server thrives on inside developer jargon, whereas a meme created for a broader audience should tap into universal everyday frustrations.
                        </li>
                    </ul>
                </div>

                <div class="rounded-3xl border border-white/10 bg-[#141418] p-6 sm:p-10">
                    <h3 class="text-xl font-bold text-ink">Built for Social Media Managers, Marketers &amp; Educators</h3>
                    <p class="mt-3">
                        Memes are no longer confined to hobbyist message boards; they have evolved into the most engaging communicative medium on the contemporary internet. Forward-thinking brands, startup founders, community managers, and university educators use memes to humanize their messaging, simplify complex technical concepts, and build authentic connections with digital-native audiences.
                    </p>
                    <p class="mt-3">
                        Because MemeMaker provides clean, unwatermarked exports, professionals can safely produce branded social campaigns, internal team sprint review humor, and presentation slide decks without embarrassing third-party logos stamped across their graphics. With lightning-fast local processing, you spend your creative energy perfecting the joke rather than wrestling with heavy graphic design software like Photoshop or Canva.
                    </p>
                </div>

                <div class="rounded-3xl border border-white/10 bg-[#141418] p-6 sm:p-10">
                    <h3 class="text-xl font-bold text-ink">Universal Device Support &amp; High-Speed Web Performance</h3>
                    <p class="mt-3">
                        Whether you are designing on a desktop widescreen monitor, a tablet on your couch, or a mobile phone on the go, MemeMaker adapts seamlessly to your screen size. The user interface features fluid gesture controls, responsive touch targets, and automatic layout scaling.
                    </p>
                    <p class="mt-3">
                        Our lightweight architecture ensures ultra-fast initial page loads under 300 milliseconds with minimal battery and memory overhead. No heavy downloads or background background bloatware—just open the browser tab, make the meme before the trend passes, and get right back to what you were doing.
                    </p>
                </div>
            </article>
        </div>
    </section>
</Layout>

<script>
    import {
        getLandingTemplatesLayout,
        getTrendingTemplates,
    } from "../lib/templateCache";
    import {
        saveImage,
        saveTemplateUrl,
        clearTemplateUrl,
        saveCustomTemplate,
        type CustomTemplate,
    } from "../lib/imageStore";
    import { supabase } from "../lib/supabase";

    let currentUserId: string | undefined = undefined;
    try {
        supabase.auth.getSession().then((res: { data: { session: { user: { id: string } } | null } }) => {
            currentUserId = res.data.session?.user?.id;
        });
        supabase.auth.onAuthStateChange((_evt: string, session: { user: { id: string } } | null) => {
            currentUserId = session?.user?.id;
        });
    } catch {}

    const templateBaseUrl = "/templates/cdn";
    const cards = Array.from(
        document.querySelectorAll<HTMLButtonElement>("[data-template-card]"),
    );

    // Retrieve persisted template layout from localStorage so page changes do not reshuffle or refetch
    const layout = getLandingTemplatesLayout(cards.length);

    cards.forEach((card, index) => {
        const item = layout[index];
        if (!item) return;

        const { templateId, width, left, top, rotation } = item;

        card.style.setProperty("--card-width", width);
        card.style.setProperty("--card-left", left);
        card.style.setProperty("--card-top", top);
        card.style.setProperty("--rotation", rotation);

        const image = card.querySelector<HTMLImageElement>(
            "[data-template-image]",
        );

        if (image) {
            image.src = `${templateBaseUrl}/${templateId}.webp`;
            image.alt = `Meme template ${templateId}`;
        }
        card.setAttribute("aria-label", `Preview meme template ${templateId}`);
        card.setAttribute("data-template-id", String(templateId));
    });

    const closeTemplates = (except?: HTMLButtonElement) => {
        cards.forEach((card) => {
            if (card !== except) {
                card.classList.remove("is-active");
                card.setAttribute("aria-pressed", "false");
            }
        });
    };

    const navigateWithTemplate = async (templateId: string) => {
        const fullImageUrl = `/templates/cdn/${templateId}.webp`;
        try {
            await saveTemplateUrl(fullImageUrl);
            await saveImage(fullImageUrl);
        } catch {}
        window.location.href = `/edit?template=${templateId}`;
    };

    cards.forEach((card) => {
        card.addEventListener("click", async (event) => {
            event.stopPropagation();

            const templateId = card.getAttribute("data-template-id");
            if (templateId) {
                await navigateWithTemplate(templateId);
                return;
            }
        });
    });

    document.addEventListener("click", () => closeTemplates());
    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") closeTemplates();
    });

    const uploadInput =
        document.querySelector<HTMLInputElement>("#meme-upload");
    const uploadStatus = document.querySelector<HTMLElement>("#upload-status");
    const uploadDropZone = document.querySelector<HTMLElement>(
        "[data-upload-drop-zone]",
    );
    const defaultUploadStatus = "PNG, JPG, WEBP or GIF · drop anywhere";

    const isAcceptedImage = (file?: File): boolean => {
        if (!file) return false;
        if (file.type && /^image\/(png|jpe?g|jpg|webp|gif|x-png)$/i.test(file.type)) {
            return true;
        }
        return /\.(png|jpe?g|jpg|webp|gif|jfif)$/i.test(file.name);
    };

    const showSelectedFile = (file?: File) => {
        if (!uploadStatus) return;

        if (!file) {
            uploadStatus.textContent = defaultUploadStatus;
            return;
        }

        if (!isAcceptedImage(file)) {
            uploadStatus.textContent =
                "Please drop a PNG, JPG, WEBP or GIF image";
            return;
        }

        if (uploadInput) {
            try {
                const transfer = new DataTransfer();
                transfer.items.add(file);
                uploadInput.files = transfer.files;
            } catch {}
        }
        uploadStatus.textContent = `Processing image: ${file.name}...`;

        const reader = new FileReader();
        reader.onload = async () => {
            const dataUrl = reader.result as string;
            uploadStatus.textContent = "Redirecting to editor...";

            const customId = "custom_" + Date.now() + "_" + Math.random().toString(36).substring(2, 7);
            const newTemplate: CustomTemplate = {
                id: customId,
                name: file.name.replace(/\.[^/.]+$/, ""),
                dataUrl: dataUrl,
                userId: currentUserId || undefined,
                createdAt: Date.now(),
            };

            try {
                await saveCustomTemplate(newTemplate);
            } catch (e) {
                console.warn("Could not save custom template:", e);
            }

            try {
                await clearTemplateUrl();
                await saveImage(dataUrl);
            } catch (err) {
                console.error("Failed to save image:", err);
            }

            window.location.href = `/edit?custom=${customId}`;
        };
        reader.onerror = () => {
            if (uploadStatus) {
                uploadStatus.textContent = "Failed to read image. Please try again.";
            }
        };
        reader.readAsDataURL(file);
    };

    uploadInput?.addEventListener("change", () => {
        showSelectedFile(uploadInput.files?.[0]);
    });

    let dragDepth = 0;
    const hasDraggedFiles = (event: DragEvent) =>
        event.dataTransfer?.types.includes("Files") ?? false;

    document.addEventListener("dragenter", (event) => {
        if (!hasDraggedFiles(event)) return;
        event.preventDefault();
        dragDepth += 1;
        uploadDropZone?.classList.add("is-dragging");
        if (uploadStatus) uploadStatus.textContent = "Drop your image here";
    });

    document.addEventListener("dragover", (event) => {
        if (!hasDraggedFiles(event)) return;
        event.preventDefault();
        if (event.dataTransfer) event.dataTransfer.dropEffect = "copy";
    });

    document.addEventListener("dragleave", (event) => {
        if (!hasDraggedFiles(event)) return;
        dragDepth = Math.max(0, dragDepth - 1);
        if (dragDepth === 0) {
            uploadDropZone?.classList.remove("is-dragging");
            if (uploadStatus) uploadStatus.textContent = defaultUploadStatus;
        }
    });

    document.addEventListener("drop", (event) => {
        if (!hasDraggedFiles(event)) return;
        event.preventDefault();
        dragDepth = 0;
        uploadDropZone?.classList.remove("is-dragging");
        showSelectedFile(event.dataTransfer?.files[0]);
    });

    // ── Trending images (persisted in localStorage across reloads) ──────
    const trendingBase = "/templates/cdn";
    const trendingCards = Array.from(
        document.querySelectorAll<HTMLAnchorElement>("[data-trending-id]"),
    );
    const trendingTemplates = getTrendingTemplates(trendingCards.length);

    trendingCards.forEach((card, index) => {
        const id = trendingTemplates[index % trendingTemplates.length];
        card.setAttribute("data-trending-id", String(id));
        card.setAttribute("aria-label", `Use meme template ${id}`);
        card.href = `/edit?template=${id}`;

        const img = card.querySelector<HTMLImageElement>("[data-trending-img]");
        if (img) {
            img.src = `${trendingBase}/${id}.webp`;
            img.alt = `Meme template ${id}`;
        }

        card.addEventListener("click", async (e) => {
            e.preventDefault();
            const fullImageUrl = `/templates/cdn/${id}.webp`;
            try {
                await saveTemplateUrl(fullImageUrl);
                await saveImage(fullImageUrl);
            } catch {}
            window.location.href = `/edit?template=${id}`;
        });
    });

    // ── Scroll-hint: hide once user scrolls ──────────────────────────
    const scrollHint = document.querySelector<HTMLElement>(".scroll-hint");
    if (scrollHint) {
        const onScroll = () => {
            if (window.scrollY > 60) {
                scrollHint.style.opacity = "0";
                scrollHint.style.transition = "opacity 0.4s";
                window.removeEventListener("scroll", onScroll);
            }
        };
        window.addEventListener("scroll", onScroll, { passive: true });
    }
</script>

<style>
    .upload-panel.is-dragging {
        border-color: white;
        background-color: rgb(18 18 18 / 0.94);
        transform: scale(1.03);
    }

    .template-card {
        aspect-ratio: 4 / 3;
        transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
    }

    @media (min-width: 64rem) {
        .template-card {
            left: var(--card-left);
            top: var(--card-top);
            width: var(--card-width);
            transform: rotate(var(--rotation));
        }

        .template-card:hover,
        .template-card:focus-visible,
        .template-card.is-active {
            z-index: 40;
            transform: rotate(0deg) scale(1.08);
        }
    }

    .template-card.is-active {
        z-index: 40;
        transform: rotate(0deg) scale(1.06);
        border-color: white;
        box-shadow: 0 20px 50px rgb(0 0 0 / 0.65);
    }

    .template-card.is-active .template-action {
        opacity: 1;
    }

    @media (prefers-reduced-motion: reduce) {
        .template-card,
        .template-card:hover,
        .template-card:focus-visible,
        .template-card.is-active {
            transform: none;
        }
    }
</style>
