---
interface FooterLink {
	label: string;
	href?: string;
	id?: string;
	external?: boolean;
	action?: string;
}

interface FooterColumn {
	title: string;
	links: FooterLink[];
}

const columns: FooterColumn[] = [
	{
		title: "Product",
		links: [
			{ label: "Meme Editor", href: "/edit" },
			{ label: "Browse Templates", href: "/templates" },
			{ label: "Trending Memes", href: "/#trending-title" },
			{ label: "Upload Image", href: "/edit?upload=1" },
		],
	},
	{
		title: "Popular Templates",
		links: [
			{ label: "Hide the Pain Harold", href: "/edit?template=20" },
			{ label: "Disaster Girl", href: "/edit?template=18" },
			{ label: "Expanding Brain", href: "/edit?template=16" },
			{ label: "Two Buttons", href: "/edit?template=3" },
			{ label: "Left Exit 12", href: "/edit?template=2" },
		],
	},
	{
		title: "About",
		links: [
			{ label: "Why free?", href: "/#why-free" },
			{ label: "No sign-up", href: "/#no-signup" },
			{ label: "No watermark", href: "/#no-watermark" },
			{ label: "All features", href: "/#features" },
		],
	},
	{
		title: "Community & Account",
		links: [
			{ label: "Create Account / Sign In", id: "footer-btn-auth", action: "auth" },
			{ label: "My Custom Templates", href: "/templates#upload-zone" },
			{ label: "GitHub Repository", href: "https://github.com/thisisvaishnav/MemeMaker", external: true },
		],
	},
];
---

<footer class="border-t border-hairline bg-canvas px-4 py-16 sm:px-6 sm:py-20">
	<div class="mx-auto max-w-350">
		<div class="grid grid-cols-2 gap-10 sm:grid-cols-4">
			{
				columns.map((col) => (
					<div>
						<p class="mb-3 font-mono text-xs uppercase tracking-wide text-mute">{col.title}</p>
						<ul class="flex flex-col gap-2.5">
							{col.links.map((link) => (
								<li>
									{link.action === "auth" ? (
										<button
											type="button"
											id={link.id}
											class="text-left text-sm text-body transition-colors hover:text-ink cursor-pointer outline-none focus-visible:underline"
										>
											{link.label}
										</button>
									) : (
										<a
											href={link.href}
											target={link.external ? "_blank" : undefined}
											rel={link.external ? "noopener noreferrer" : undefined}
											class="inline-flex items-center gap-1 text-sm text-body transition-colors hover:text-ink outline-none focus-visible:underline"
										>
											{link.label}
											{link.external && (
												<svg class="h-3 w-3 opacity-60" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
													<path d="M6 3h7v7M13 3L7 9"/>
												</svg>
											)}
										</a>
									)}
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>

		<div class="mt-14 flex flex-col items-start justify-between gap-4 border-t border-hairline pt-6 sm:flex-row sm:items-center">
			<p class="flex items-center gap-2 text-sm text-mute">
				<span class="flex h-5 w-5 items-center justify-center rounded-md bg-primary text-on-primary">
					<svg width="11" height="11" viewBox="0 0 16 16" fill="none" aria-hidden="true">
						<path d="M8 1L15 14H1L8 1Z" fill="currentColor" />
					</svg>
				</span>
				MemeMaker — free, no sign-up, no watermark.
			</p>
			<a
				href="/"
				class="font-mono text-xs text-mute transition-colors hover:text-ink"
			>
				mememaker.com
			</a>
		</div>
	</div>
</footer>

<script>
	const authBtn = document.getElementById("footer-btn-auth");
	authBtn?.addEventListener("click", () => {
		if (typeof window.openAuthModal === "function") {
			window.openAuthModal("signup");
		}
	});
</script>
