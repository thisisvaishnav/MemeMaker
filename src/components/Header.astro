---
import AuthModal from "./AuthModal.astro";
---

<header
    class="sticky top-0 z-50 h-16 border-b border-white/5 bg-transparent backdrop-blur-md"
>
    <div
        class="mx-auto flex h-16 max-w-350 items-center justify-between gap-4 px-4 sm:px-6"
    >
        <a
            href="/"
            class="flex items-center gap-2 text-[15px] font-semibold tracking-tight text-ink"
        >
            <span
                class="flex h-7 w-7 items-center justify-center rounded-md bg-primary text-on-primary font-bold"
            >
                <svg
                    width="16"
                    height="16"
                    viewBox="0 0 16 16"
                    fill="none"
                    aria-hidden="true"
                >
                    <path d="M8 1L15 14H1L8 1Z" fill="currentColor"></path>
                </svg>
            </span>
            MemeMaker
        </a>

        <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
            <a
                href="/#templates"
                class="rounded-full px-3 py-1.5 font-mono text-[13px] text-body transition-colors hover:bg-canvas-soft-2 hover:text-ink"
            >
                Templates
            </a>
            <a
                href="/edit"
                class="rounded-full px-3 py-1.5 font-mono text-[13px] text-body transition-colors hover:bg-canvas-soft-2 hover:text-ink"
            >
                Editor
            </a>
        </nav>

        <div class="flex items-center gap-3">
            <!-- Unauthenticated State -->
            <div id="auth-unauthenticated" class="flex items-center gap-2">
                <button
                    type="button"
                    id="btn-header-login"
                    class="rounded-full px-3.5 py-1.5 text-xs font-semibold text-body transition-colors hover:bg-white/5 hover:text-ink"
                >
                    Sign In
                </button>
            </div>

            <!-- Authenticated State (Hidden by default until session loaded) -->
            <div id="auth-authenticated" class="hidden items-center gap-2">
                <div
                    class="flex items-center gap-2 rounded-full border border-white/10 bg-white/5 py-1 pl-1 pr-3 shadow-sm"
                >
                    <div
                        id="user-avatar-container"
                        class="flex h-7 w-7 items-center justify-center overflow-hidden rounded-full bg-primary/20 text-xs font-bold text-primary"
                    >
                        <span id="user-avatar-initial">?</span>
                        <img
                            id="user-avatar-img"
                            src=""
                            alt="Avatar"
                            class="hidden h-full w-full object-cover"
                        />
                    </div>
                    <span
                        id="user-display-name"
                        class="max-w-[120px] truncate text-xs font-medium text-ink sm:max-w-[160px]"
                    >
                        User
                    </span>
                </div>

                <button
                    type="button"
                    id="btn-header-logout"
                    class="rounded-full px-2.5 py-1 text-xs font-medium text-mute transition-colors hover:bg-white/5 hover:text-red-400"
                    title="Sign Out"
                >
                    Sign Out
                </button>
            </div>

            <a
                href="/edit"
                class="inline-flex h-9 items-center rounded-pill bg-primary px-4 text-sm font-medium text-on-primary outline-none transition-opacity hover:opacity-85 focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2"
            >
                Create Meme
            </a>
        </div>
    </div>
</header>

<AuthModal />

<script>
    import { supabase } from "../lib/supabase";

    const unauthContainer = document.getElementById("auth-unauthenticated");
    const authContainer = document.getElementById("auth-authenticated");
    const loginBtn = document.getElementById("btn-header-login");
    const logoutBtn = document.getElementById("btn-header-logout");
    const userNameSpan = document.getElementById("user-display-name");
    const avatarImg = document.getElementById("user-avatar-img") as HTMLImageElement | null;
    const avatarInitial = document.getElementById("user-avatar-initial");

    loginBtn?.addEventListener("click", () => {
        if (window.openAuthModal) {
            window.openAuthModal("signin");
        }
    });

    logoutBtn?.addEventListener("click", async () => {
        try {
            await supabase.auth.signOut();
        } catch (err) {
            console.error("Error signing out:", err);
        }
    });

    function updateUserUI(user: any) {
        if (!user) {
            unauthContainer?.classList.remove("hidden");
            authContainer?.classList.add("hidden");
            authContainer?.classList.remove("flex");
            return;
        }

        // Determine user display name
        const metadata = user.user_metadata || {};
        const name =
            metadata.full_name ||
            metadata.name ||
            metadata.user_name ||
            (user.email ? user.email.split("@")[0] : "Account");

        const avatarUrl = metadata.avatar_url || metadata.picture;

        if (userNameSpan) userNameSpan.textContent = name;

        if (avatarUrl && avatarImg && avatarInitial) {
            avatarImg.src = avatarUrl;
            avatarImg.classList.remove("hidden");
            avatarInitial.classList.add("hidden");
        } else if (avatarInitial && avatarImg) {
            avatarInitial.textContent = (name[0] || "U").toUpperCase();
            avatarInitial.classList.remove("hidden");
            avatarImg.classList.add("hidden");
        }

        unauthContainer?.classList.add("hidden");
        authContainer?.classList.remove("hidden");
        authContainer?.classList.add("flex");
    }

    // Check current active session
    supabase.auth.getSession().then(({ data: { session } }) => {
        updateUserUI(session?.user || null);
    });

    // Listen to real-time auth changes (Sign in, Sign out, Token Refresh)
    supabase.auth.onAuthStateChange((_event, session) => {
        updateUserUI(session?.user || null);
    });
</script>
