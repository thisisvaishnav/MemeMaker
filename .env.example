# Supabase Configuration
# Get these from: Supabase Dashboard -> Project Settings -> API Keys
PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Optional: Supabase publishable key (for future client-side use)
# SUPABASE_KEY=your-publishable-key

# Analytics (Optional — remove to disable Google Analytics entirely)
# PUBLIC_GA_ID=G-XXXXXXXXXX
