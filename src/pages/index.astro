---
import Layout from "../layouts/Layout.astro";
import { getTemplates } from "../lib/template-service";

export const prerender = false;

const templates = await getTemplates({ allowFallback: true });
const first = templates[0] || {
    id: "drake",
    name: "Drake",
    originalUrl: "/templates/drake.svg",
    thumbnailUrl: "/templates/drake.svg",
    width: 900,
    height: 675,
};

// 7 floating template card positions matching the reference design (desktop perimeter):
const heroSlots = [
    // 1. top-left card
    { ...(templates[0] || first), pos: "left-[3%] top-[8%] w-36 xl:w-44 -rotate-6" },
    // 2. upper-left/mid card
    { ...(templates[1] || first), pos: "left-[2%] top-[34%] w-34 xl:w-42 rotate-6" },
    // 3. bottom-left card
    { ...(templates[4] || first), pos: "left-[2%] bottom-[12%] w-36 xl:w-44 -rotate-3" },
    // 4. top-right card
    { ...(templates[2] || first), pos: "right-[3%] top-[8%] w-36 xl:w-44 rotate-6" },
    // 5. right-middle card
    { ...(templates[3] || first), pos: "right-[2%] top-[34%] w-34 xl:w-42 -rotate-6" },
    // 6. bottom-right card
    { ...(templates[5] || first), pos: "right-[2%] bottom-[12%] w-36 xl:w-44 rotate-3" },
    // 7. lower-right card
    { ...(templates[6] || first), pos: "right-[14%] bottom-[4%] w-32 xl:w-38 -rotate-6" },
];
---

<Layout
    title="MemeMaker — Free online meme generator, no sign-up."
    showHeader={false}
    showFooter={false}
>
    <main
        class="relative flex min-h-screen w-full flex-col overflow-hidden px-4 pb-14 pt-[28px] sm:px-6"
    >
        <!-- Full-viewport pastel mesh gradient backdrop -->
        <div
            class="mesh-gradient pointer-events-none absolute inset-0 -z-10 h-full w-full"
            aria-hidden="true"
        >
        </div>

        <!-- 1. HEADER: Centered floating glassmorphism navigation pill -->
        <header
            class="relative z-30 mx-auto flex h-[68px] w-full max-w-[680px] items-center justify-between rounded-full border border-white/80 bg-white/70 px-5 shadow-[0_8px_30px_rgb(0,0,0,0.06)] backdrop-blur-xl transition-all sm:px-6"
        >
            <!-- Left: Logo & text -->
            <a
                href="/"
                class="flex items-center gap-2.5 text-ink outline-none transition-opacity hover:opacity-85 focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2"
            >
                <span
                    class="flex h-8 w-8 items-center justify-center rounded-xl bg-ink text-white shadow-sm"
                >
                    <svg
                        width="18"
                        height="18"
                        viewBox="0 0 16 16"
                        fill="none"
                        aria-hidden="true"
                    >
                        <path d="M8 1L15 14H1L8 1Z" fill="currentColor"></path>
                    </svg>
                </span>
                <span class="text-[16px] font-bold tracking-tight text-ink">
                    MemeMaker
                </span>
            </a>

            <!-- Center: Navigation links -->
            <nav
                class="hidden items-center gap-7 sm:flex"
                aria-label="Primary Navigation"
            >
                <a
                    href="#popular-templates"
                    class="text-sm font-medium text-body/90 transition-colors hover:text-ink"
                >
                    Templates
                </a>
                <a
                    href="/edit"
                    class="text-sm font-medium text-body/90 transition-colors hover:text-ink"
                >
                    Editor
                </a>
            </nav>

            <!-- Right: Create Meme button -->
            <a
                href="/edit"
                class="inline-flex h-11 items-center justify-center rounded-full bg-ink px-5 text-sm font-semibold text-white shadow-sm outline-none transition-all hover:bg-black/85 hover:shadow focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2"
            >
                Create Meme
            </a>
        </header>

        <!-- FLOATING IMAGES: scattered template cards around the hero (desktop) -->
        <div
            class="pointer-events-none absolute inset-0 hidden lg:block"
            aria-hidden="false"
        >
            {
                heroSlots.map((slot) => (
                    <a
                        href={`/edit?template=${slot.id}`}
                        class:list={[
                            "hero-slot group pointer-events-auto absolute block transition-transform duration-300 hover:scale-105 hover:z-20",
                            slot.pos,
                        ]}
                    >
                        <span class="relative block overflow-hidden rounded-2xl border border-white/80 bg-white/40 p-1 shadow-lg shadow-black/8 backdrop-blur-sm">
                            <img
                                src={slot.thumbnailUrl || slot.src}
                                alt={slot.name}
                                width={slot.width}
                                height={slot.height}
                                class="aspect-4/3 w-full rounded-xl object-cover opacity-90 transition-opacity group-hover:opacity-100"
                                loading="eager"
                            />
                            <span class="absolute inset-0 flex items-center justify-center rounded-xl bg-ink/40 opacity-0 transition-opacity group-hover:opacity-100">
                                <span class="rounded-full bg-white px-3 py-1.5 text-xs font-semibold text-ink shadow-md">
                                    Use Template
                                </span>
                            </span>
                        </span>
                    </a>
                ))
            }
        </div>

        <!-- HERO HEADER CONTENT -->
        <div
            class="relative z-10 mx-auto flex w-full max-w-[640px] flex-col items-center pt-[42px] text-center sm:pt-[54px]"
        >
            <!-- BADGE: ~70px below header -->
            <span
                class="inline-flex items-center rounded-full border border-black/5 bg-white/75 px-4 py-1.5 font-mono text-xs font-medium text-body shadow-sm backdrop-blur-md"
            >
                free · no sign-up · no watermark
            </span>

            <!-- TITLE: Large bold/black heading -->
            <h1
                class="mt-4 text-[38px] font-extrabold leading-[1.1] tracking-[-0.035em] text-ink sm:text-[46px] md:text-[50px]"
            >
                Make a meme in seconds.
            </h1>

            <!-- SUBTITLE: Center aligned -->
            <p
                class="mt-3.5 max-w-[600px] text-base leading-[1.5] text-body sm:text-[17px]"
            >
                Pick a template or upload any image, add your captions, and
                download the PNG. Entirely in your browser — nothing is ever
                uploaded to a server.
            </p>

            <!-- BUTTONS: Horizontal & centered -->
            <div class="mt-6 flex flex-wrap items-center justify-center gap-3 sm:mt-7">
                <!-- Start Creating (black background, sparkle icon) -->
                <a
                    href="/edit"
                    class="inline-flex h-12 items-center justify-center gap-2.5 rounded-full bg-ink px-7 text-sm font-semibold text-white shadow-md shadow-black/10 outline-none transition-all hover:scale-[1.02] hover:bg-black/85 active:scale-[0.98] focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2 sm:text-base"
                >
                    <svg
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path
                            d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3L12 3Z"
                        ></path>
                        <path d="M5 3v4"></path>
                        <path d="M19 17v4"></path>
                        <path d="M3 5h4"></path>
                        <path d="M17 19h4"></path>
                    </svg>
                    <span>Start Creating</span>
                </a>

                <!-- Browse Templates (white background, grid icon) -->
                <a
                    href="#popular-templates"
                    class="inline-flex h-12 items-center justify-center gap-2.5 rounded-full border border-black/10 bg-white/90 px-7 text-sm font-semibold text-ink shadow-sm backdrop-blur-sm outline-none transition-all hover:scale-[1.02] hover:border-black/20 hover:bg-white active:scale-[0.98] focus-visible:ring-2 focus-visible:ring-link sm:text-base"
                >
                    <svg
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <rect width="7" height="7" x="3" y="3" rx="1"></rect>
                        <rect width="7" height="7" x="14" y="3" rx="1"></rect>
                        <rect width="7" height="14" x="14" y="14" rx="1"></rect>
                        <rect width="7" height="7" x="3" y="14" rx="1"></rect>
                    </svg>
                    <span>Browse Templates</span>
                </a>
            </div>
        </div>

        <!-- MAIN CREATION AREA (Expanded Upload Box + Popular Templates Grid) -->
        <section
            class="relative z-10 mx-auto mt-8 w-full max-w-[1040px] sm:mt-10"
            aria-label="Create meme workspace"
        >
            <div
                class="flex flex-col gap-7 rounded-3xl border border-white/80 bg-white/70 p-5 shadow-[0_12px_40px_rgb(0,0,0,0.06)] backdrop-blur-xl sm:p-7 md:p-8"
            >
                <!-- 1. EXPANDED UPLOAD BOX -->
                <div
                    data-dropzone
                    tabindex="0"
                    role="button"
                    aria-label="Upload your own image to start editing"
                    class="group relative flex min-h-[200px] w-full cursor-pointer flex-col items-center justify-center gap-3.5 rounded-2xl border-2 border-dashed border-black/15 bg-white/60 px-6 py-8 text-center shadow-sm backdrop-blur-md outline-none transition-all duration-200 hover:border-ink hover:bg-white/85 hover:shadow-md focus-visible:ring-2 focus-visible:ring-link sm:min-h-[230px] sm:py-10"
                >
                    <div
                        class="flex h-13 w-13 items-center justify-center rounded-2xl border border-black/5 bg-white/90 text-ink shadow-sm transition-transform duration-200 group-hover:scale-110 group-hover:bg-ink group-hover:text-white"
                    >
                        <svg
                            width="26"
                            height="26"
                            viewBox="0 0 24 24"
                            fill="none"
                            aria-hidden="true"
                        >
                            <path
                                d="M12 16V4M12 4L7 9M12 4L17 9M5 16v2a2 2 0 002 2h10a2 2 0 002-2v-2"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            ></path>
                        </svg>
                    </div>

                    <div class="space-y-1">
                        <p class="text-[17px] font-bold tracking-tight text-ink sm:text-[19px]">
                            Upload your own image / drag & drop
                        </p>
                        <p class="text-xs text-body sm:text-sm font-medium">
                            Drop any picture here or click to browse from your device
                        </p>
                    </div>

                    <div class="inline-flex items-center gap-1.5 rounded-full border border-black/5 bg-white/80 px-3.5 py-1 font-mono text-[11px] text-mute shadow-2xs">
                        <span>PNG · JPG · WEBP · GIF</span>
                        <span class="text-black/30">·</span>
                        <span>processed locally</span>
                    </div>

                    <input
                        data-dropzone-input
                        type="file"
                        accept="image/*"
                        class="hidden"
                    />
                </div>

                <!-- 2. POPULAR TEMPLATES SECTION -->
                <div id="popular-templates" class="flex flex-col gap-3.5 scroll-mt-24">
                    <!-- Section header -->
                    <div class="flex items-center justify-between px-1">
                        <div class="flex items-center gap-2.5">
                            <h2 class="text-base font-bold tracking-tight text-ink sm:text-lg">
                                Popular Templates
                            </h2>
                            <span
                                class="inline-flex items-center rounded-full border border-black/5 bg-white px-2.5 py-0.5 font-mono text-[11px] font-semibold text-body shadow-2xs"
                            >
                                {templates.length} templates
                            </span>
                        </div>

                        <a
                            href="/edit"
                            class="inline-flex items-center gap-1 text-xs font-semibold text-ink/80 transition-colors hover:text-ink sm:text-sm"
                        >
                            <span>Open in editor</span>
                            <svg
                                width="14"
                                height="14"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <path d="M5 12h14M12 5l7 7-7 7"></path>
                            </svg>
                        </a>
                    </div>

                    <!-- Dense Responsive Grid: Desktop 6-8 per row, Tablet 4-6, Mobile 2-3 -->
                    <div
                        data-template-grid
                        class="grid grid-cols-2 gap-2.5 min-[480px]:grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 xl:grid-cols-8 sm:gap-3"
                    >
                        {
                            templates.map((t) => (
                                <a
                                    href={`/edit?template=${t.id}`}
                                    class="group relative flex flex-col overflow-hidden rounded-2xl border border-white/90 bg-white/70 p-1.5 shadow-2xs backdrop-blur-xs transition-all duration-200 hover:-translate-y-1 hover:scale-[1.03] hover:border-black/20 hover:bg-white hover:shadow-md focus-visible:ring-2 focus-visible:ring-link focus-visible:outline-none"
                                    aria-label={`Use ${t.name} meme template`}
                                >
                                    <div class="relative aspect-4/3 w-full overflow-hidden rounded-xl bg-canvas-soft-2">
                                        <img
                                            src={t.thumbnailUrl || t.originalUrl || t.src}
                                            alt={t.name}
                                            width={t.width || 900}
                                            height={t.height || 675}
                                            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                                            loading="lazy"
                                        />
                                        <div class="absolute inset-0 flex items-center justify-center bg-ink/35 opacity-0 backdrop-blur-[1px] transition-opacity duration-200 group-hover:opacity-100">
                                            <span class="rounded-full bg-white px-2.5 py-1 text-[11px] font-bold text-ink shadow-sm">
                                                Use
                                            </span>
                                        </div>
                                    </div>
                                    <div class="px-1 pt-1.5 pb-0.5 text-center">
                                        <p class="truncate text-[11.5px] font-semibold text-ink/90 group-hover:text-ink">
                                            {t.name}
                                        </p>
                                    </div>
                                </a>
                            ))
                        }
                    </div>
                </div>
            </div>
        </section>
    </main>

    <script src="../scripts/landing.ts"></script>
</Layout>
